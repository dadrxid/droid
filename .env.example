DISCORD_TOKEN=
DATA_DIR=./data
YOUTUBE_API_KEY=

############
# Optional #
############

# BOT_OWNER_ID=your_discord_user_id
# Pings this user when a custom build sheet is submitted. Defaults to Andrew if unset.

# Ticket system: syncs tickets and transcripts to droidfix.uk/staff/tickets.
# Use the same value as DROIDFIX_BOT_TOKEN on Railway. Leave unset and Discord
# still works, the website copy is just skipped.
# DROIDFIX_BOT_TOKEN=
# DROIDFIX_SITE_URL=https://droidfix.uk
# DROIDFIX_MENU_URL=https://droidfix.uk/api/droid-rollers-menu
# Enable "Message Content Intent" in the Discord Developer Portal for FAQ auto-replies.
# HOMELAB_API_URL=https://api.droidlab.org
# PLAYLIST_API_URL=https://playlist.droidlab.org

# CACHE_LIMIT=2GB

# ENABLE_SPONSORBLOCK=true
# SPONSORBLOCK_TIMEOUT=5    # Delay (in mn) before retrying when SponsorBlock server are unreachable.
# YT_DLP_PATH=yt-dlp
# YT_DLP_AUTO_UPDATE=true

# Bot presence (DroidFix promo defaults if unset)
# BOT_STATUS=online
# BOT_ACTIVITY_TYPE=PLAYING
# BOT_ACTIVITY=Droid Rollers - droidfix.uk
# BOT_ACTIVITY_URL=
